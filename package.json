{
  "name": "creator-aware-reel-agent-demo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "capture": "node scripts/capture.mjs",
    "smoke:autoplay": "node scripts/smoke-autoplay.mjs",
    "smoke:layout": "node scripts/smoke-layout.mjs",
    "smoke:journeys": "node scripts/smoke-journeys.mjs",
    "smoke": "node scripts/smoke-memory.mjs && node scripts/smoke-v3.mjs && node scripts/smoke-journeys.mjs && node scripts/smoke-layout.mjs && node scripts/smoke-autoplay.mjs && node scripts/smoke-media.mjs && node scripts/smoke-rail.mjs",
    "smoke:v3": "node scripts/smoke-v3.mjs",
    "capture:v3": "node scripts/capture.mjs v3",
    "capture:v31": "node scripts/capture.mjs v31",
    "smoke:memory": "node scripts/smoke-memory.mjs",
    "smoke:media": "node scripts/smoke-media.mjs",
    "smoke:rail": "node scripts/smoke-rail.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^23.10.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
